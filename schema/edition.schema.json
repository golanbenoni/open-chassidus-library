{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chassid.ai/schema/edition-v1.json",
  "title": "Open Chassidus Library edition record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "work_id", "edition_id", "title", "language", "direction", "edition_details", "attribution", "source", "rights", "content_checksum", "sections", "segments"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "work_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "edition_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "publication_year": {"type": ["integer", "null"], "minimum": 1},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"},
    "direction": {"enum": ["ltr", "rtl"]},
    "edition_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "version_title", "version_source", "source_license", "source_status", "accessed_on", "section_count", "segment_count", "completeness"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "version_title": {"type": "string", "minLength": 1},
        "version_source": {"type": "string", "format": "uri"},
        "source_license": {"type": "string", "minLength": 1},
        "source_status": {"type": "string"},
        "accessed_on": {"type": "string", "format": "date"},
        "section_count": {"type": "integer", "minimum": 1},
        "segment_count": {"type": "integer", "minimum": 1},
        "completeness": {"type": "string", "minLength": 1}
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher", "digitization_platform", "credit", "source_page"],
      "properties": {
        "publisher": {"type": "string", "minLength": 1},
        "digitization_platform": {"type": "string", "minLength": 1},
        "credit": {"type": "string", "minLength": 1},
        "source_page": {"type": "string", "format": "uri"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "accessed_on", "source_checksum", "transcription_method", "transcriber"],
      "properties": {
        "kind": {"enum": ["public_scan", "owned_copy", "licensed_digital_source"]},
        "reference": {"type": "string", "minLength": 1},
        "accessed_on": {"type": "string", "format": "date"},
        "source_checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "transcription_method": {"enum": ["manual", "ocr_human_reviewed", "publisher_text"]},
        "transcriber": {"type": "string", "minLength": 1}
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "evidence", "reviewed_on", "reviewer"],
      "properties": {
        "basis": {"enum": ["public_domain", "written_permission", "open_license"]},
        "evidence": {"type": "string", "minLength": 1},
        "license": {"type": ["string", "null"]},
        "reviewed_on": {"type": "string", "format": "date"},
        "reviewer": {"type": "string", "minLength": 1}
      }
    },
    "content_checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reference", "order", "segment_count"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[./-][a-z0-9]+)*$"},
          "reference": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 1},
          "segment_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "section_id", "section_reference", "position", "reference", "text"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[./-][a-z0-9]+)*$"},
          "section_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[./-][a-z0-9]+)*$"},
          "section_reference": {"type": "string", "minLength": 1},
          "position": {"type": "string", "pattern": "^[1-9][0-9]*(?:\.[1-9][0-9]*)*$"},
          "reference": {"type": "string", "minLength": 1},
          "text": {"type": "string"}
        }
      }
    }
  }
}
